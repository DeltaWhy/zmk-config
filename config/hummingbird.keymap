#define ZMK_POINTING_DEFAULT_MOVE_VAL 1000
#define ZMK_POINTING_DEFAULT_SCRL_VAL 15

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define DEF_L 0
#define NAV_L 1
#define NUM_L 2
#define SYM_L 3
#define OTH_L 4

// Using layer taps on thumbs, having quick tap as well helps w/ repeating space/backspace

&lt { quick_tap_ms = <200>; };

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "homerow mods";
            #binding-cells = <2>;
            tapping_term_ms = <225>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        next_tab: next_tab {
            compatible = "zmk,behavior-smart-toggle";
            #binding-cells = <0>;
            bindings = <&kp LCTRL>, <&kp TAB>;
            ignored-key-positions = <1>;
        };

        next_win: next_win {
            compatible = "zmk,behavior-smart-toggle";
            #binding-cells = <0>;
            bindings = <&kp LALT>, <&kp TAB>;
            ignored-key-positions = <11>;
        };
    };

    combos {
        compatible = "zmk,combos";

        /* ====== Default Layer ====== */
        /* ====== Number Layer ====== */

        q {
            bindings = <&kp Q>;
            key-positions = <1 2>;
            layers = <0>;
        };

        j {
            bindings = <&kp J>;
            key-positions = <2 3>;
            layers = <0>;
        };

        lbrk {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <11 12>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <12 13>;
        };

        z {
            bindings = <&kp Z>;
            key-positions = <20 21>;
            layers = <0>;
        };

        v {
            bindings = <&kp V>;
            key-positions = <22 21>;
            layers = <0>;
        };

        mouse {
            bindings = <&tog 4>;
            key-positions = <20 22>;
        };

        quot {
            bindings = <&kp SQT>;
            key-positions = <6 7>;
        };

        grave {
            bindings = <&kp GRAVE>;
            key-positions = <7 8>;
        };

        bksp {
            bindings = <&kp BACKSPACE>;
            key-positions = <16 17>;
        };

        rbrk {
            bindings = <&kp RBKT>;
            key-positions = <17 18>;
        };

        bslsh {
            bindings = <&kp BACKSLASH>;
            key-positions = <23 24>;
        };

        slsh {
            bindings = <&kp SLASH>;
            key-positions = <24 25>;
        };

        scln {
            bindings = <&kp SEMI>;
            key-positions = <23 25>;
        };

        esc {
            bindings = <&kp ESC>;
            key-positions = <11 12 13>;
        };

        entr {
            bindings = <&kp ENTER>;
            key-positions = <16 17 18>;
        };

        lpar {
            bindings = <&kp LPAR>;
            key-positions = <11 13>;
        };

        rpar {
            bindings = <&kp RPAR>;
            key-positions = <16 18>;
        };

        caps_word {
            bindings = <&caps_word>;
            key-positions = <13 16>;
        };

        excl {
            bindings = <&kp EXCL>;
            key-positions = <3 2>;
            layers = <1>;
        };

        boot {
            bindings = <&bootloader>;
            key-positions = <26 29>;
            layers = <3>;
        };

        boot2 {
            bindings = <&bootloader>;
            key-positions = <4 5>;
            layers = <3>;
        };

        play {
            bindings = <&kp C_PLAY_PAUSE>;
            key-positions = <4 14>;
            layers = <2>;
        };
    };
};

/ {
    keymap {
        compatible = "zmk,keymap";

        /*              +-----+                             +-----+  
          +-----+  R  +-----+                 +-----+  U  +-----+
    +-----+  D  +-----+  W  +-----+     +-----+  F  +-----+  P  +-----+
    | TAB +-----+S[H] +-----+  B  |     |  J  +-----+S[E] +-----+ B.S |
    +-----+A[S] +-----+C[T] +-----+     +-----+C[N] +-----+A[O] +-----+
    |G[A] +-----+  V  +-----+  G  |     |  Y  +-----+  K  +-----+G[I] |
    +-----+  C  +-----+  M  +-----+     +-----+  L  +-----+  .  +-----+
          +-----+     +-----+       STD       +-----+     +-----+
                        +-----+              +-----+
                        |[SYM]+-----+  +-----+[OTH]|
                        | TAB |[NUM]|  |[NAV]+ RET |
                        +-----+ SPC |  | SPC +-----+
                              +-----+  +-----+                        */

        default_layer {
            bindings = <
&kp Q       &kp W       &kp F        &kp P             &kp B          &kp K  &kp L          &kp U        &kp Y       &kp SQT
&hm LGUI A  &hm LALT R  &hm LCTRL S  &hm LEFT_SHIFT T  &kp G          &kp M  &hm RSHFT N    &hm RCTRL E  &hm RALT I  &hm RGUI O
            &kp X       &kp C        &lt 4 D                                 &kp H          &kp COMMA    &kp DOT
                                     &mt LCTRL ESC     &lt 2 SPACE    &mo 1  &mt RSHFT RET
            >;
        };

        /*              +-----+                             +-----+  
          +-----+ F9  +-----+                 +-----+  ^  +-----+
    +-----+ F8  +-----+ F10 +-----+     +-----+ Hme +-----+ End +-----+
    | F7  +-----+ > < +-----+ F11 |     | P.U +-----+  v  +-----+     |
    +-----+ > < +-----+ > < +-----+     +-----+  <  +-----+  >  +-----+
    | > < +-----+COPY +-----+ F12 |     | P.D +-----+     +-----+ DEL |
    +-----+ CUT +-----+PASTE+-----+     +-----+ INS +-----+     +-----+
          +-----+     +-----+       NAV       +-----+     +-----+
                        +-----+             +-----+
                        |UNDO +-----+ +=====+ DEL |
                        +-----+REDO | | NAV +-----+
                              +-----+ +=====+         */

        sym_layer {
            label = "Sym";
            bindings = <
&kp LS(EXCL)  &kp LS(AT)     &kp LS(POUND)  &kp LS(DLLR)  &kp LS(PRCNT)    &kp COMMA  &kp N7  &kp N8  &kp N9  &kp BKSP
&kp LS(PLUS)  &kp EQUAL      &kp LS(UNDER)  &kp MINUS     &kp LS(CARET)    &kp N0     &kp N4  &kp N5  &kp N6  &kp DOT
              &kp LS(QMARK)  &kp LS(STAR)   &kp LS(AMPS)                              &kp N1  &kp N2  &kp N3
                                            &kp BSPC      &trans           &trans     &trans
            >;
        };

        /*              +-----+                             +-----+  
          +-----+ F3  +-----+                 +-----+  8  +-----+
    +-----+ F2  +-----+ F4  +-----+     +-----+  7  +-----+  9  +-----+
    | F1  +-----+ > < +-----+ F5  |     |  #  +-----+  5  +-----+ DEL |
    +-----+ > < +-----+ > < +-----+     +-----+  4  +-----+  6  +-----+
    | > < +-----+     +-----+ F6  |     |  .  +-----+  2  +-----+  0  |
    +-----+     +-----+     +-----+     +-----+  1  +-----+  3  +-----+
          +-----+     +-----+       NUM       +-----+     +-----+
                        +-----+             +-----+
                        |     +=====+ +-----+  =  |
                        +-----+ NUM | |     +-----+
                              +=====+ +-----+         */

        nav_layer {
            label = "Nav";
            bindings = <
&trans  &kp LC(LS(TAB))        &next_tab         &trans          &kp C_VOLUME_UP    &kp INS   &kp PG_DN   &kp UP          &kp PG_UP   &trans
&trans  &kp LS(TAB)        &next_win         &kp LSHFT       &kp C_VOL_DN       &kp HOME  &kp LEFT    &kp DOWN        &kp RIGHT   &kp END
        &kp C_AC_CUT  &kp C_AC_COPY  &kp C_AC_PASTE                               &kp DELETE  &kp C_PREVIOUS  &kp C_NEXT
                                     &trans          &trans             &trans    &kp SPACE
            >;
        };

        fn_layer {
            bindings = <
&trans  &kp F1   &kp F2   &kp F3   &kp F4    &trans  &trans    &trans           &trans           &trans
&kp F5  &kp F6   &kp F7   &kp F8   &kp F9    &trans  &trans    &trans           &trans           &trans
        &kp F10  &kp F11  &kp F12                    &kp CAPS  &kp PRINTSCREEN  &kp PAUSE_BREAK
                          &trans   &trans    &trans  &trans
            >;

            label = "Function";
        };

        mouse_layer {
            bindings = <
&mkp MB5  &mkp MB4   &mkp RCLK  &none      &none    &mkp RCLK       &msc SCRL_DOWN  &mmv MOVE_UP    &msc SCRL_UP     &none
&kp LGUI  &kp LALT   &kp LCTRL  &kp LSHFT  &none    &msc SCRL_LEFT  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &msc SCRL_RIGHT
          &mkp MCLK  &mkp LCLK  &trans                              &mkp MB4        &mkp MCLK       &mkp MB5
                                &none      &none    &mkp LCLK       &mkp RCLK
            >;

            label = "Mouse";
        };

        /*              +-----+                             +-----+  
          +-----+  *  +-----+                 +-----+  }  +-----+
    +-----+  &  +-----+  (  +-----+     +-----+  {  +-----+  +  +-----
    |  {  +-----+  %  +-----+  }  |     |  /  +-----+  )  +-----+     |
    +-----+  $  +-----+  ^  +-----+     +-----+  (  +-----+  -  +-----+
    |  :  +-----+  @  +-----+  +  |     |  \  +-----+  ]  +-----+  =  |
    +-----+  !  +-----+  #  +-----+     +-----+  [  +-----+  *  +-----+
          +-----+     +-----+       SYM       +-----+     +-----+
                        +=====+             +-----+
                        | SYM +-----+ +-----+     |
                        +=====+     | |     +-----+
                              +-----+ +-----+        */
        /*              +-----+                             +-----+  
          +-----+  {  +-----+                 +-----+     +-----+
    +-----+     +-----+  }  +-----+     +-----+     +-----+     +-----+
    |     +-----+  (  +-----+     |     |     +-----+     +-----+     |
    +-----+     +-----+  )  +-----+     +-----+     +-----+     +-----+
    |     +-----+  [  +-----+     |     |     +-----+     +-----+     |
    +-----+     +-----+  ]  +-----+     +-----+     +-----+     +-----+
          +-----+     +-----+       OTH       +-----+     +-----+
                        +-----+             +=====+
                        |     +-----+ +-----+ OTH |
                        +-----+     | |     +=====+
                              +-----+ +-----+         */
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        tri {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };
};
